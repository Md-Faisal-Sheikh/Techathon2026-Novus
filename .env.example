# ---- Backend ----
PORT=3000

# ---- Simulation ----
SIM_INTERVAL_MS=3000
FAN_WATTS=60
LIGHT_WATTS=15

# ---- Electricity tariff ----
# BDT per kWh, used to convert watts/kWh into a taka figure for the dashboard
# and bot ("Burning ৳12/hour right now"). Adjust to your real commercial rate.
TARIFF_BDT_PER_KWH=10

# ---- Office hours (24h clock) ----
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=17

# ---- Alerts ----
# Room "all-on too long" threshold, in hours. Lower to ~0.02 (about 72s) to make
# the alert appear quickly during a live demo.
ROOM_ON_HOURS_THRESHOLD=2
# Force "after office hours" so the after-hours alert always shows in a demo.
FORCE_AFTER_HOURS=false

# ---- Discord bot ----
# Create an application + bot at https://discord.com/developers/applications
# Enable the "Message Content Intent", invite the bot, then paste its token here.
DISCORD_TOKEN=
# Channel ID for proactive alert posts (right-click channel -> Copy ID). Optional.
DISCORD_ALERT_CHANNEL_ID=
COMMAND_PREFIX=!
ALERT_POLL_MS=30000

# Where the bot reads the shared backend from (defaults to the local server).
# API_BASE_URL=http://localhost:3000

# ---- Optional LLM humanizer ----
# If set, bot replies are phrased conversationally by the model. If empty, the
# bot uses friendly built-in templates and runs fully offline.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
